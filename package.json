{
  "name": "bini-native",
  "version": "2.0.0",
  "description": "Automatic Tauri native feature detection and wiring",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "bini-router": ">=2",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.1",
    "bini-router": "2.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "keywords": [
    "tauri",
    "bini",
    "native",
    "vite",
    "plugin",
    "automation"
  ],
  "license": "MIT",
  "author": "Binidu01",
  "repository": {
    "type": "git",
    "url": "https://github.com/Binidu01/bini-native.git"
  },
  "bugs": {
    "url": "https://github.com/Binidu01/bini-native/issues"
  },
  "homepage": "https://github.com/Binidu01/bini-native#readme",
  "publishConfig": {
    "access": "public"
  }
}